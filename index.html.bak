<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nathan Obiri - Content Writer</title>
    <link rel="stylesheet" href="styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <header>
        <nav>
            <div class="logo">NO</div>
            <ul>
                <li><a href="#home">Home</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#articles">Articles</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </nav>
    </header>

    <section id="home" class="hero">
        <div class="hero-content">
            <h1>Nathan Obiri</h1>
            <p>Content Writer & Digital Storyteller</p>
            <a href="#contact" class="cta-button">Get in Touch</a>
        </div>
    </section>

    <section id="about" class="about">
        <div class="container">
            <h2>About Me</h2>
            <div class="about-content">
                <div class="about-text">
                    <p>Hi there! I'm Nathan Obiri, a passionate 23-year-old content writer based in Kenya. With a keen eye for detail and a love for storytelling, I create engaging content that resonates with audiences.</p>
                    <p>My expertise lies in crafting compelling narratives that inform, entertain, and inspire action. Whether it's blog posts, articles, or social media content, I deliver high-quality work that meets your needs.</p>
                </div>
            </div>
        </div>
    </section>

    <section id="articles" class="articles">
        <div class="container">
            <h2>Featured Articles</h2>
            <div class="articles-grid">
                <article class="article-card">
                    <div class="article-image" style="background-image: url('https://source.unsplash.com/800x600/?digital-marketing')"></div>
                    <div class="article-content">
                        <h3>The Future of Digital Marketing</h3>
                        <p>Explore the latest trends and strategies shaping the digital marketing landscape in 2025.</p>
                        <a href="#" class="read-more">Read More</a>
                    </div>
                </article>

                <article class="article-card">
                    <div class="article-image" style="background-image: url('https://source.unsplash.com/800x600/?content-creation')"></div>
                    <div class="article-content">
                        <h3>Content Creation for the Modern Age</h3>
                        <p>Discover how to create content that stands out in today's crowded digital space.</p>
                        <a href="#" class="read-more">Read More</a>
                    </div>
                </article>

                <article class="article-card">
                    <div class="article-image" style="background-image: url('https://source.unsplash.com/800x600/?social-media')"></div>
                    <div class="article-content">
                        <h3>Social Media Strategy Guide</h3>
                        <p>Learn the essential strategies for building a successful social media presence.</p>
                        <a href="#" class="read-more">Read More</a>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <section id="contact" class="contact">
        <div class="container">
            <h2>Contact Me</h2>
            <div class="contact-content">
                <div class="contact-info">
                    <div class="contact-item">
                        <i class="fas fa-envelope"></i>
                        <p>nathanobiri36@gmail.com</p>
                    </div>
                    <div class="contact-item">
                        <i class="fas fa-phone"></i>
                        <p>+254 796 008 989</p>
                    </div>
                </div>
                <form class="contact-form">
                    <input type="text" placeholder="Your Name" required>
                    <input type="email" placeholder="Your Email" required>
                    <textarea placeholder="Your Message" required></textarea>
                    <button type="submit" class="submit-button">Send Message</button>
                </form>
            </div>
        </div>
    </section>

    <footer>
        <div class="container">
            <p>&copy; 2025 Nathan Obiri. All rights reserved.</p>
            <div class="social-links">
                <a href="#"><i class="fab fa-linkedin"></i></a>
                <a href="#"><i class="fab fa-twitter"></i></a>
                <a href="#"><i class="fab fa-instagram"></i></a>
            </div>
        </div>
    </footer>

    <script src="script.js"></script>
</body>
</html>
